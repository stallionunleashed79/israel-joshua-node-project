{
    "extends": [
        "eslint:recommended",
        "plugin:prettier/recommended"
    ],
    "rules": {
        "no-console": "off",
        "no-unused-vars": "warn",
        "prettier/prettier": [
            "error",
            {
                "endOfLine": "auto"
            }
        ]
    },
    "env": {
        "browser": true,
        "node": true,
        "es2024": true
    }
}